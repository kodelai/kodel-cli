{
  "name": "kodel-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:agents": "KODEL_AGENT_TESTS=1 bun test tests/agents --timeout 900000",
    "test:agents:stats": "bun tests/agents/run-stats.ts",
    "build": "bun run --cwd packages/cli build",
    "check:artifact": "node scripts/check-artifact.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}

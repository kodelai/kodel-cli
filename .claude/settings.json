{
  "enabledMcpjsonServers": ["kodel"],
  "permissions": {
    "allow": ["mcp__kodel"],
    "deny": [
      "Edit(.kodel/runs/**)",
      "Write(.kodel/runs/**)",
      "Edit(.kodel/pipelines/**)",
      "Write(.kodel/pipelines/**)",
      "Edit(.mcp.json)",
      "Write(.mcp.json)",
      "Edit(.claude/settings*.json)",
      "Write(.claude/settings*.json)",
      "Bash(*kodel* gate*)",
      "Bash(*kodel* ack *)",
      "Bash(*kodel* seal *)",
      "Bash(*kodel* resume *)",
      "Bash(*main.ts* gate*)",
      "Bash(*main.ts* ack *)",
      "Bash(*main.ts* seal *)",
      "Bash(*main.ts* resume *)"
    ]
  }
}
